# Ejemplo: nginx sirviendo dist/ con la API en el mismo sitio (/api), siendo
# nginx lo primero que recibe las peticiones (sin CDN ni balanceador delante).
#
# Cabeceras de seguridad, en cada despliegue (llevan el hash del build):
#   yarn build
#   CSP_IMG_ORIGINS="https://<proyecto>.supabase.co" yarn -s headers --nginx > /etc/nginx/aula360-headers.conf
#   nginx -t && nginx -s reload
# Con un hash viejo el script del tema queda bloqueado y el tema no se aplica.

server_tokens off;

# http solo redirige a https (M1 de la 3g-1): nunca se sirve la aplicación
# sin cifrar, ni siquiera en la primera visita.
server {
    listen 80;
    listen [::]:80;
    server_name app.colegio.co;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.colegio.co;

    # ssl_certificate     /etc/ssl/...;
    # ssl_certificate_key /etc/ssl/...;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/aula360/dist;
    index index.html;

    # Nada de archivos ocultos (.env, .git) ni mapas de código, aunque llegaran
    # a dist/ por error (B2 de la 3g-1).
    location ~ /\. {
        return 404;
    }
    location ~* \.map$ {
        return 404;
    }

    # La API (NestJS) bajo /api, en el mismo origen: las cookies SameSite=Lax
    # viajan y el backend valida el Origin (CORS_ORIGINS=https://app.colegio.co,
    # FRONTEND_URL igual).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        # nginx es el borde: la IP real es la de la conexión; lo que envíe el
        # cliente en X-Forwarded-For se descarta. En el backend, TRUST_PROXY=1.
        # Con una CDN o balanceador delante, usar real_ip (set_real_ip_from) y
        # ajustar TRUST_PROXY al número de saltos (B5 de la 3g-1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Subidas: el backend corta en 2 MB (imágenes) y 256 KB (plantillas).
        client_max_body_size 3m;
        # Boletines y vistas previas se imprimen con Chromium (I5 de la 3g-1).
        proxy_read_timeout 90s;
    }

    # Archivos con hash en el nombre: caché de un año.
    location /assets/ {
        include /etc/nginx/aula360-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Aplicación de una sola página: cualquier ruta devuelve index.html, sin caché.
    location / {
        include /etc/nginx/aula360-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}

# nginx no hereda add_header de niveles superiores si el bloque define alguno
# propio: por eso cada location incluye el archivo de cabeceras.
#
# HSTS: max-age de un año con includeSubDomains. Para la lista de precarga de
# los navegadores (hstspreload.org) haría falta max-age=63072000; includeSubDomains;
# preload, un compromiso para todo el dominio y todos sus subdominios que tarda
# meses en revertirse: decidirlo con quien administra el dominio del colegio.
